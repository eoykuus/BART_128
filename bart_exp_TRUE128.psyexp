        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Bu oyunda bir balon şişirme yarışmasında olabildiğince fazla para kazanmaya çalışacaksınız. &amp;#10;&amp;#10;Şişirdiğiniz her balondan, balondaki hava kadar para kazanacaksınız. Ancak balonu fazla şişirip patlatırsanız o balondan hiç kazanç sağlayamayacaksınız. Balon patladığında sesini duyabileceksiniz. İstediğiniz zaman balonu şişirmeyi bırakıp, paranızı alıp yeni balona geçebilirsiniz.&amp;#10;&amp;#10;Her bir balon patlamadan önce pompalayabildiğiniz hava miktarı farklıdır. &amp;#10;&amp;#10;Lütfen &amp;#10;     Balonu şişirmek için BOŞLUK tuşuna&amp;#10;     Balonu şişirmeyi sonlandırıp paranızı almak ve yeni balona geçmek için ENTER tuşuna basın. &amp;#10;&amp;#10;Lütfen devam etmek için BOŞLUK tuşunu kullanın.&amp;#10;" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
      </TextboxComponent>
